# Public-source repository guardrails
#
# This project is developed beside locally owned game assets and extracted
# reference data. Keep those files local. Do not remove these rules unless the
# relevant copyright holder has explicitly licensed the files for publishing.

# Images, documents, audio, video, archives, and font files
*.atopack
*.png
*.jpg
!/tools/packaging/android/app/src/main/res/drawable-nodpi/app_icon.jpg
*.jpeg
*.webp
*.psd
*.gif
*.bmp
*.tif
*.tiff
*.svg
*.pdf
*.mp3
*.wav
*.ogg
*.m4a
*.flac
*.mp4
*.webm
*.mov
*.zip
*.tar
*.7z
*.rar
*.ttf
*.otf
*.woff
*.woff2

# Complete or extracted copyrighted game/story data
/story/data.js
/story/data/
/story/audio/
/story/audio-packs/
# Source excerpts and original book graphics are private optional materials.
/story/assets/mixed-media/mapping.js
/story/assets/mixed-media/images/
/supplements/

# Locally generated story/OCR/reference datasets (scripts remain publishable)
/tools/bgstorybook-*.json
/tools/*-storybook-diff.json
/tools/ocr-*.json
/tools/fsadf.txt
/tools/exploration-effect-automation-report.csv
/tools/exploration-effect-automation-report.md
/tools/.packaging-cache/

# Asset-heavy/reference-only working areas
/assets/*
!/assets/ato-terms.js
!/assets/exploration-card-rules.js
# 探索卡资源结算的运行时数据与逻辑（脚本生成，index.html 直接引用，必须随源码发布）
!/assets/exploration-card-resource-rules.js
!/assets/exploration-card-resources.js
!/assets/exploration-card-tags.js
!/assets/page-focus-router.js
!/assets/campaign-session.js
!/assets/record-attachments.js
# 五个页面共用的循环图标注入模块（主控台 ./、子页面 ../），随源码发布
!/assets/cycle-symbols.js
# Shared application appearance controls and cross-module theme synchronization.
!/assets/theme.js
!/assets/theme.css
!/assets/story-doom-card-data.js
!/assets/term-language.js
!/assets/english-terms.js
!/assets/english-ui.js
!/assets/english-language.js
# 应用自身的更新检测脚本，不是版权素材，随源码发布
!/assets/update/
# 第三方 GIF 编码器（MIT，gifenc 1.0.3）：浏览器不能自己生成 GIF，
# 战役简报的 GIF 导出要用它，代码随源码发布
!/assets/vendor/
!/assets/vendor/gifenc.js
# 主控台 BGM：播放器代码随源码发布，音频仍被 *.mp3 / *.ogg 规则忽略
!/assets/bgm/
# 主控台「导入状态」的官方 .jsave 转换器与官方枚举/卡名数据表：
# index.html 按 jsave-tables.js → jsave-import.js 顺序直接引用，必须随源码发布
!/assets/jsave-import.js
!/assets/jsave-tables.js

# Local official-Chinese image overrides are read only by the explicit asset
# pack exporters; they must never be part of a source or application release.
/official-assets/*
!/official-assets/README.md
/map/images/
/map/tokens/
/record/assets/
/story/battle-images/
/story/c1-battle-images/
/story/c3-battle-images/
/story/images/battles/
# C5 补充页扫描（story/images/c5/supplement-pages/）与战斗版图一样，只作为资料包素材
# 由 asset-studio 的固定清单分发（见 tools/packaging/package_common.py 的
# C5_SUPPLEMENT_PAGES_DIR），不进版本库、也不进程序包。
/story/images/c5/
# C5 战斗版图（/story/images/battles/c5/）同样不进版本库，随 .atopack 分发；
# 生成脚本见 tools/.packing-scratch/c5-boards.py（该目录是本机草稿，同样不进版本库）。
/tools/.packing-scratch/
/technology/images/

# 巴别语／塞壬语字形（story/assets/cryptic/glyphs/*.png）由上面的 *.png 规则一并挡住：
# 它们是第三方参考素材，跟 assets/icons/ 的界面图标一样只随 .atopack 的 crypticFiles 段
# 分发（见 asset-studio/app/cryptic_resources.py）。同目录的 glyph-catalog.js 是程序代码，
# 必须随源码发布，所以这里**不要**整目录忽略。

# Private campaign/user state and local backups
/data/
/logs/
/log/
/export/
/output/
/outputs/
# Local audio-duration probe output and its one-off script.
/durations.json
/probe_durations.py
php_errors.log
error_log
*.backup
*.backup.*
*.bak
*.atoback
*.atoback.partial
*.tmp
*.tmp.*
*.log
*.lock

# 一次性排查草稿，不随源码发布
/tmp/
api/.ato-update-*
# 隔离用例在源码树里留下的临时目录（简报 API / 战役 API 的合成分账号数据）
/api/tmp/
/briefing/tmp/

# Local TTS credentials (copy from tools/xfyun-long-tts.config.example.json)
/tools/xfyun-long-tts.config.json

# Local/editor/runtime files
__pycache__/
*.py[cod]
/.claude/
/.vscode/
/.idea/
.DS_Store
Thumbs.db
desktop.ini

# 官方 APK 解包产物（不进仓库，500MB+）
/app-extract/

# 官方存档导入的地图/探针工作目录（临时脚本与 dump，报告留在工作区但不进仓库）
/map-import-work/
